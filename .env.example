# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# NEVER prefix a secret with NEXT_PUBLIC_ — that ships it to every phone.

# Your funded Monad testnet wallet. Paste the private key yourself; it is the
# source of funds for everything else. `npm run wallets` will NOT overwrite it.
MASTER_KEY=

# Generated by `npm run wallets` — leave blank on first run.
RELAYER_KEYS=

# Private RPC (Alchemy / QuickNode free tier). Strongly recommended: the public
# endpoint is rate-limited per-IP and a whole venue shares one IP.
MONAD_RPC_URL=

# Deployed contract, filled in by `npm run deploy`.
NEXT_PUBLIC_CONTRACT=

# Public salt for burner-key derivation. Changing it after people have joined
# invalidates their wallets, so set it once and leave it.
NEXT_PUBLIC_EVENT_SALT=bidblitz-hyd-v3

# Upstash Redis — atomic funding lock + relayer nonce allocation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only used to authorise GET /api/fund?heal=<secret>, the relayer nonce
# recovery. There is no admin login any more: room hosts are proven on-chain by
# the wallet that created the room.
ADMIN_SECRET=

# Stretch: AI bidder.
ANTHROPIC_API_KEY=
