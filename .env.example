# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# NEVER prefix a secret with NEXT_PUBLIC_ — that ships it to every phone in the room.

# Your existing funded Monad testnet wallet. Paste the private key here yourself;
# it is the source of funds for everything else. `npm run wallets` will NOT
# overwrite this if it is already set.
MASTER_KEY=

# Generated by `npm run wallets` — leave blank on first run.
ORGANIZER_KEY=
RELAYER_KEYS=

# Private RPC (Alchemy / QuickNode free tier). Strongly recommended: the public
# endpoint is rate-limited per-IP and the whole venue shares one IP.
MONAD_RPC_URL=

# Deployed contract, filled in by `npm run deploy`.
NEXT_PUBLIC_CONTRACT=

# Public salt for burner-key derivation. Any random string; changing it after
# the event starts invalidates everyone's wallet, so set it once and leave it.
NEXT_PUBLIC_EVENT_SALT=bidblitz-hyd-v3

# Organizer auth for /admin. Sent in a POST body, never a query string.
ADMIN_SECRET=

# Upstash Redis — atomic funding lock + relayer nonce allocation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stretch: AI bidder.
ANTHROPIC_API_KEY=
