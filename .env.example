# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# NEVER prefix a secret with NEXT_PUBLIC_ — that ships it to every phone.
#
# NOTE: BidBlitz does not hold a treasury. Hosts and bidders pay for their own
# gas and their own bids out of their own wallets, and FREE rooms are off-chain
# so they cost nobody anything. There is no server-side key that can spend MON.

# --- local development only ---------------------------------------------------
# A funded testnet wallet used for exactly two things, both from your laptop:
# deploying the contract (`npm run deploy`) and funding the bot script
# (`npm run bots`). It is never deployed and never funds a real participant.
MASTER_KEY=

# Private RPC (Alchemy / QuickNode free tier). Strongly recommended: the public
# endpoint is rate-limited per-IP and a whole venue shares one IP. It also lifts
# the ~96-block eth_getLogs cap that truncates room history.
MONAD_RPC_URL=

# --- app ----------------------------------------------------------------------
# Deployed contract, filled in by `npm run deploy`.
NEXT_PUBLIC_CONTRACT=

# Upstash Redis — rate limiting for free (off-chain) rooms and the tx counter.
# Optional: without it those fall back to a per-instance in-memory map, which is
# fine on one laptop and useless across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase — room metadata, item roster, avatars, and the whole state of FREE
# rooms. The chain stays the source of truth for anything involving MON.
# From Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where players' MON goes when they buy a points pack in a FREE room. Your own
# receiving address. Public by nature (it appears in every buyer's wallet), so
# NEXT_PUBLIC_ is correct here — but it is the ADDRESS, never a private key.
# Leave blank to disable point packs entirely.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Server-side Supabase key. Required for free rooms: their bids are written
# through API routes that verify the caller, never straight from the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the bot script's throwaway wallets (`npm run bots`). This used to
# derive real participants' burner wallets from a name + password; it no longer
# does, because one keccak of a guessable string is not somewhere MON should sit.
NEXT_PUBLIC_EVENT_SALT=bidblitz-hyd-v3

# OpenRouter — AI bidders in demo/solo mode. Server-side only (never shipped to
# the browser). Without it, demo/solo fall back to scripted bots.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
